# 줄바꿈 통일: 저장소에는 LF로 저장 (Windows·Mac·리눅스 공통)
* text=auto eol=lf

# Windows 전용 실행 파일은 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 리눅스에서 실행되는 스크립트는 LF 고정
gradlew  text eol=lf
*.sh     text eol=lf

# 바이너리: 줄바꿈 변환·비교 안 함
*.xlsx binary
*.xls  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.jar  binary
*.zip  binary
